

<header class="site-header">

    <div class="logo">
        <a href="/">
            <img src="/assets/images/logo.png" alt="CGCarpentry logo">
        </a>
    </div>

    <!-- Hamburger button -->
    <button
        class="hamburger"
        id="hamburger"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="nav-menu">
        ☰
    </button>

    <!-- Navigation menu -->
    <nav id="nav-menu" class="nav-menu">
        <ul>
            <li>
                <a class="{{#if state.home}}active{{/if}}" href="/">Home</a>
            </li>
            <li>
                <a class="{{#if state.about}}active{{/if}}" href="/about">About</a>
            </li>
            <li>
                <a class="{{#if state.images}}active{{/if}}" href="/responsiveexample">Responsiveexample</a>
            </li>
            <li>
                <a class="{{#if state.location}}active{{/if}}" href="/location">Location</a>
            </li>
            <li>
                <a class="{{#if state.contact}}active{{/if}}" href="/contact">Contact</a>
            </li>
        </ul>
    </nav>

    <script src="/js/script.js" defer></script>

</header>
